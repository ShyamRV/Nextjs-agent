# Copy to .env and fill in values. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
AGENT_SEED=
ASI_ONE_API_KEY=

# ── ASI:One LLM (optional overrides) ─────────────────────────────────────────
# ASI_ONE_BASE_URL=https://api.asi1.ai/v1
# ASI_ONE_MODEL=asi1
# ASI1_USE_SESSION_HEADER=true

# ── Agentverse ────────────────────────────────────────────────────────────────
AGENTVERSE_URL=https://agentverse.ai
AGENT_NAME=nextjs_sandbox_agent
AGENT_PORT=8029
SHUTDOWN_TIMEOUT_SECONDS=60

# ── Postgres (optional — enables persistent LangGraph checkpointing) ───────────
# DATABASE_URL=postgresql://user:pass@localhost:5432/agents_dev
# Install langgraph-checkpoint-postgres + psycopg[binary] if you set this.

# ── Sandbox ───────────────────────────────────────────────────────────────────
# Directory for workspace temp folders (default: system temp)
SANDBOX_WORKSPACE_ROOT=
SANDBOX_BUILD_MAX_RETRIES=5
SANDBOX_KEEP_WORKSPACES=false

# Reuse one workspace per Agentverse session for follow-up edits (recommended)
NEXTJS_SESSION_WORKSPACE=true

NPM_INSTALL_TIMEOUT_SEC=600
NPM_BUILD_TIMEOUT_SEC=600
NPM_WAIT_FOR_INSTALL_SEC=600

# ── Preview ───────────────────────────────────────────────────────────────────
SKIP_PREVIEW_DEV=false
# Set true to use `next dev` instead of `next start` (production)
PREVIEW_USE_NEXT_DEV=false
# Public base URL for local preview (e.g. https://myserver.example.com)
PREVIEW_PUBLIC_BASE_URL=
# Seconds before preview server stops and workspace is cleaned up
PREVIEW_KEEPALIVE_SEC=600
# Keep preview alive after agent Ctrl+C (you must stop Node manually)
PREVIEW_DETACH_FROM_AGENT=false

# ── E2B (optional) — public preview URLs, free Hobby tier at https://e2b.dev ─
# E2B_API_KEY=
# PREVIEW_USE_E2B=true
# E2B_SANDBOX_TEMPLATE=base
# E2B_SANDBOX_TIMEOUT_SEC=3500
# E2B_NPM_INSTALL_TIMEOUT_SEC=600
# E2B_NPM_BUILD_TIMEOUT_SEC=600
# E2B_PROJECT_REMOTE_DIR=/home/user/nextjs_sandbox_app
# E2B_UPLOAD_BATCH=40

# ── GitHub (optional) — publish workspace as a GitHub repo ───────────────────
#
# Option A — Per-user OAuth device flow (recommended; repos under the user's account)
# Create a GitHub OAuth App, enable Device flow, set:
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_DEVICE_SCOPE=repo
#
# Option B — Operator/bot PAT (repos under the bot account)
# Classic PAT: repo scope. Fine-grained: Contents write + Metadata read.
# GITHUB_TOKEN=
#
# GitHub Enterprise API base (default: https://api.github.com)
# GITHUB_API_URL=https://api.github.com
#
# GITHUB_DEVICE_MAX_POLLS_PER_CALL=10  ← OAuth poll budget per chat turn (device flow)

# ── Vercel (optional) — deploy via REST API (same token as dashboard) ─────────
# Get your token from https://vercel.com/account/tokens
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=   ← optional, for team accounts (team_… id)
# VERCEL_API_BASE=https://api.vercel.com  ← override API host if needed
